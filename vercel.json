{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": ".",
        "buildCommand": "npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/client/public/(.*)",
      "dest": "/client/public/$1"
    },
    {
      "src": "/client/styling/(.*)",
      "dest": "/client/styling/$1"
    },
    {
      "src": "/client/app/(.*)",
      "dest": "/client/app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/client/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
